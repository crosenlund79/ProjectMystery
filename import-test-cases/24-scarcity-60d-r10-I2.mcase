      "members": [
       "K0093",
       "K0095"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Ruth was asking around for money a while ago, and Agnes said no.",
      "time": 6529,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
