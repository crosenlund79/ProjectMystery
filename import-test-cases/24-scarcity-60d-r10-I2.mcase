       },
       {
        "from": 9976,
        "hedged": false,
        "place": "home:lind",
        "to": 10559,
        "who": "bruno"
       }
      ],
      "guarded": false,
      "key": "K0125",
      "members": [
       "K0126"
      ],
      "place": null,
      "source": "self",
      "text": "On Day 7, from about 16:15 I was at home; at the Grey Heron from about 21:15; home around 22:15 and to bed.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "bruno"
      ],
      "facts": [
       {
        "from": 9611,
        "hedged": false,
        "place": "home:lind",
        "to": 9908,
        "who": "bruno"
       },
       {
        "from": 9908,
        "hedged": false,
        "place": "square",
        "to": 9910,
        "who": "bruno"
       },
       {
        "from": 9910,
        "hedged": false,
        "place": "pub",
        "to": 9972,
        "who": "bruno"
       },
       {
        "from": 9972,
        "hedged": false,
        "place": "square",
        "to": 9976,
        "who": "bruno"
       },
       {
        "from": 9976,
        "hedged": false,
        "place": "home:lind",
        "to": 10559,
        "who": "bruno"
       }
      ],
      "guarded": false,
      "in": "K0125",
      "key": "K0126",
      "place": null,
      "source": "self",
      "text": "On Day 7: from about 16:15 to 21:15 I was at home, asleep for most of it; around 21:08 I passed through the square; from about 21:15 to 22:15 I was at the Grey Heron; around 22:12 I passed through the square; from about 22:15 to 08:00 I was at home, asleep for most of it.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0127",
      "place": null,
      "source": "told",
      "text": "Anton told me there's bad blood between them and Ruth \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0128",
      "place": null,
      "source": "saw",
      "text": "I saw someone turn Ruth down for credit at the grocery around 09:45 on Day 1.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0129",
      "place": null,
      "source": "told",
      "text": "Viktor told me Anton owes Agnes 43 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0158",
      "key": "K0130",
      "place": null,
      "source": "told",
      "text": "Viktor told me they refused Ruth credit at the grocery around 09:45 on Day 1.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0131",
      "place": null,
      "source": "told",
      "text": "Tomas told me Anton paid Agnes back 43 crowns around 08:45 on Day 1.",
      "time": 526,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0132",
      "place": null,
      "source": "told",
      "text": "Viktor told me Ruth has been short of money \u2014 cannot pay for food.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0133",
      "place": null,
      "source": "told",
      "text": "Viktor told me Ruth has been taking food on credit from them (54 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0134",
      "place": null,
      "source": "told",
      "text": "Tomas told me they owe Ruth 70 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0158",
      "key": "K0135",
      "place": null,
      "source": "saw",
      "text": "I saw Viktor turn Ruth down for credit at the grocery around 11:00 on Day 4.",
      "time": 4973,
      "topics": [
       "money",
       "person:ruth",
       "person:viktor"
      ]
     },
     {
      "about": [
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0136",
      "place": null,
      "source": "saw",
      "text": "I saw Viktor turn someone down for credit at the grocery around 12:00 on Day 5.",
      "time": 6475,
      "topics": [
       "money",
       "person:viktor"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0137",
      "place": "grocery",
      "source": "told",
      "text": "Agnes told me about 18 crowns missing from the grocery till; it went missing from about 09:00 to 18:00 on Day 5.",
      "time": 6295,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
