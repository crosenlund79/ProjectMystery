       }
      ],
      "guarded": false,
      "in": "K0351",
      "key": "K0352",
      "place": null,
      "source": "self",
      "text": "On Day 7: from about 16:15 to 08:00 I was at home, asleep for most of it.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0353",
      "place": null,
      "source": "told",
      "text": "Anton told me there's bad blood between them and Ruth \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0354",
      "place": null,
      "source": "told",
      "text": "Agnes told me Anton owes them 43 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0385",
      "key": "K0355",
      "place": null,
      "source": "self",
      "text": "I turned Ruth down when they asked me for credit at the grocery, around 09:45 on Day 1.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0385",
      "key": "K0356",
      "place": null,
      "source": "self",
      "text": "Ruth came asking me for money, around 09:45 on Day 1. Times are hard for them.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0357",
      "place": null,
      "source": "told",
      "text": "Bruno told me someone refused Ruth credit at the grocery around 09:45 on Day 1.",
      "time": 589,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
