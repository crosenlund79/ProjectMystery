      "members": [
       "K0352"
      ],
      "place": null,
      "source": "self",
      "text": "On Day 7, from about 16:15 I was at home.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "viktor"
      ],
      "facts": [
       {
