      ],
      "guarded": false,
      "in": "K0223",
      "key": "K0224",
      "place": null,
      "source": "self",
      "text": "On Day 7: from about 16:15 to 18:15 I was at home; around 18:16 I passed through Mill Road; around 18:22 I passed through the square; from about 18:30 to 21:00 I was at the Grey Heron; around 21:03 I passed through the square; around 21:09 I passed through Mill Road; from about 21:15 to 08:00 I was at home, asleep for most of it.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0225",
      "place": null,
      "source": "told",
      "text": "Anton told me there's bad blood between them and Ruth \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0226",
      "place": null,
      "source": "told",
      "text": "Agnes told me Anton owes them 43 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0227",
      "place": null,
      "source": "self",
      "text": "I owe Anton 64 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:anton"
      ]
     },
     {
      "about": [
       "anton",
       "margaret"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0228",
      "place": null,
      "source": "self",
      "text": "I paid Anton back the 64 crowns I owed, around 17:45 on Day 1.",
      "time": 1071,
      "topics": [
       "money",
       "person:anton"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0229",
      "place": null,
      "source": "told",
      "text": "Arvid told me Anton paid Agnes back 43 crowns around 08:45 on Day 1.",
      "time": 526,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0230",
      "place": null,
      "source": "told",
      "text": "Agnes told me Ruth has been taking food on credit from Viktor (54 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "tomas"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0231",
      "place": null,
      "source": "told",
      "text": "Arvid told me Tomas owes Ruth 70 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0232",
      "place": null,
      "source": "told",
      "text": "Emil told me Agnes refused Ruth a loan around 12:45 on Day 5.",
      "time": 6529,
      "topics": [
       "money",
       "person:agnes",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "margaret",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0257",
      "key": "K0233",
      "place": null,
      "source": "self",
      "text": "I turned Ruth down when they asked me for a loan, around 14:00 on Day 6.",
      "time": 8035,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0257",
      "key": "K0234",
      "place": null,
      "source": "self",
      "text": "Ruth came asking me for money, around 14:00 on Day 6. Times are hard for them.",
      "time": 8035,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": true,
      "key": "K0235",
      "place": "grocery",
      "source": "told",
      "text": "Emil told me about 18 crowns missing from the grocery till; it went missing from about 09:00 to 18:00 on Day 5.",
      "time": 6295,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0236",
      "place": null,
      "source": "saw",
      "text": "I saw Agnes turn Tomas down for a loan around 20:45 on Day 6.",
      "time": 8447,
      "topics": [
       "money",
       "person:agnes",
       "person:tomas"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0237",
      "place": "grocery",
      "source": "inferred",
      "text": "If you ask me, Ruth had something to do with 18 crowns missing from the grocery till.",
      "time": 6295,
      "topics": [
