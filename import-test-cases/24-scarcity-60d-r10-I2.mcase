       "K0077",
       "K0078"
      ],
      "place": "pub",
      "source": "saw",
      "text": "At the Grey Heron, from about 17:00 to 23:00 on Day 7, I saw Agnes, Arvid, Bruno, Clara, Emil, Margaret, Ruth and Tomas, coming and going; Agnes, Emil and Margaret were the worse for drink.",
      "time": 9659,
      "topics": [
       "window"
      ]
     },
     {
      "about": [
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0084",
      "members": [
       "K0073",
       "K0074"
      ],
      "place": null,
      "source": "self",
      "text": "Tomas has come to me for money lately, and I had to say no.",
      "time": 9955,
      "topics": [
       "money"
      ]
     }
    ],
    "style": "nervous"
   },
   "arvid": {
