      "guarded": false,
      "in": "K0085",
      "key": "K0086",
      "place": null,
      "source": "self",
      "text": "On Day 7: from about 16:15 to 19:15 I was at home; around 19:09 I passed through the square; from about 19:15 to 22:15 I was at the Grey Heron; around 22:09 I passed through the square; from about 22:15 to 07:15 I was at home, asleep for most of it; around 07:09 I passed through the square; around 07:15 I passed through Mill Road; from about 07:15 to 08:00 I was at the mill; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0087",
      "place": null,
      "source": "told",
      "text": "Agnes told me there's bad blood between Anton and Ruth \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "anton"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0088",
      "place": null,
      "source": "told",
      "text": "Agnes told me Anton owes them 43 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:anton",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0089",
      "place": null,
      "source": "told",
      "text": "Agnes told me Tomas owes Ruth 70 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "margaret"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0090",
      "place": null,
      "source": "told",
      "text": "Margaret told me they paid Anton back 64 crowns around 17:45 on Day 1.",
      "time": 1071,
      "topics": [
       "money",
       "person:anton",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth",
       "viktor"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0091",
      "place": null,
      "source": "told",
      "text": "Margaret told me Ruth has been taking food on credit from Viktor (54 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0092",
      "place": null,
      "source": "told",
      "text": "Margaret told me they owe Anton 64 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:anton",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0121",
      "key": "K0093",
      "place": null,
      "source": "saw",
      "text": "I saw Agnes turn Ruth down for a loan around 12:45 on Day 5.",
      "time": 6529,
      "topics": [
       "money",
       "person:agnes",
       "person:ruth"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0094",
      "place": null,
      "source": "told",
      "text": "Agnes told me Ruth has been short of money \u2014 asking around for money.",
      "time": 6529,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0121",
      "key": "K0095",
      "place": null,
      "source": "told",
      "text": "Emil told me Agnes refused Ruth a loan around 13:15 on Day 5.",
      "time": 6559,
      "topics": [
       "money",
       "person:agnes",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0122",
      "key": "K0096",
      "place": "grocery",
      "source": "told",
      "text": "Bruno told me Ruth had something to do with 18 crowns missing from the grocery till.",
      "time": 6295,
      "topics": [
       "past",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
