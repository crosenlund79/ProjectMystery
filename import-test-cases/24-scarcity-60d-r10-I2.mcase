      "key": "K0314",
      "place": null,
      "source": "self",
      "text": "On Day 7: from about 16:15 to 21:15 I was at home, asleep for most of it; around 21:18 I passed through Mill Road; around 21:24 I passed through the square; from about 21:30 to 22:00 I was at the Grey Heron; around 22:04 I passed through the square; around 22:10 I passed through Mill Road; from about 22:15 to 08:00 I was at home, asleep for most of it.",
      "time": 9611,
      "topics": [
       "whereabouts"
      ]
     },
