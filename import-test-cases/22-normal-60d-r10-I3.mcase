       "K0079",
       "K0084"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Agnes and Bruno owe Selma money.",
      "time": null,
      "topics": [
       "money",
       "person:selma",
       "rumors"
      ]
     },
     {
