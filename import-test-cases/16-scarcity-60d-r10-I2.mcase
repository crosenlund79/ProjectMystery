       }
      ],
      "guarded": false,
      "key": "K0128",
      "place": "pub",
      "source": "told",
      "text": "Agnes told me they confronted Ida at the Lantern around 18:45 on Day 13 \u2014 an accusation over 18 crowns missing from the grocery till.",
      "time": 18412,
      "topics": [
       "conflicts",
       "person:agnes",
       "person:ida",
       "rumors",
       "window"
      ]
     },
     {
      "about": [
       "agnes",
       "ida"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0129",
      "members": [
       "K0083",
       "K0094"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Ida was asking around for money a while ago, and Agnes said no.",
      "time": 9889,
      "topics": [
       "money",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "henrik",
       "ida"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0130",
      "members": [
       "K0087",
       "K0100"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Henrik and Ida over the 18 crowns missing from the grocery till.",
      "time": 8279,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "henrik",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0131",
      "members": [
       "K0088",
       "K0091"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Henrik and Ida owe Agnes money.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0132",
      "members": [
       "K0101",
       "K0103",
       "K0112"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Ida has been asking around for money lately, and Agnes said no.",
      "time": 16728,
      "topics": [
       "money",
       "person:ida",
       "rumors"
      ]
     },
