      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0140",
      "place": "grocery",
      "source": "inferred",
      "text": "If you ask me, Ida had something to do with 18 crowns missing from the grocery till.",
      "time": 8249,
      "topics": [
       "past",
       "person:ida"
      ]
     },
     {
      "about": [],
