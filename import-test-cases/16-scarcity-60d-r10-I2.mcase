      "in": "K0264",
      "key": "K0265",
      "place": null,
      "source": "self",
      "text": "On Day 12: from about 09:00 to 16:15 I was at the mill; around 16:15 I passed through Mill Road; around 16:21 I passed through the square; from about 16:30 to 07:00 I was at home, asleep for most of it; around 07:07 I passed through the square; around 07:13 I passed through Mill Road; from about 07:15 to 16:15 I was at the mill; around 16:14 I passed through Mill Road; around 16:20 I passed through the square; from about 16:30 to 17:00 I was at home; around 17:05 I passed through the square; from about 17:00 to 18:15 I was at the grocery; around 18:10 I passed through the square; from about 18:15 to 22:15 I was at the Lantern; around 22:15 I passed through the square; from about 22:15 to 07:00 I was at home, asleep for most of it.",
      "time": 16380,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "felix",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0266",
      "place": null,
      "source": "told",
      "text": "Tomas told me Felix owes them 38 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:felix",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "elias"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0267",
      "place": null,
      "source": "told",
      "text": "Tomas told me there's bad blood between Anton and Elias \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:elias",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0268",
      "place": null,
      "source": "told",
      "text": "Tomas told me Anton couldn't pay the rent to them.",
      "time": 10560,
      "topics": [
       "money",
       "person:anton",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "ida",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0269",
      "place": null,
      "source": "told",
      "text": "Tomas told me Ida couldn't pay the rent to them.",
      "time": 10560,
      "topics": [
       "money",
       "person:ida",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
