      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0271",
      "place": null,
      "source": "told",
      "text": "Elias told me Anton paid Tomas back 40 crowns around 18:45 on Day 8.",
      "time": 11207,
      "topics": [
