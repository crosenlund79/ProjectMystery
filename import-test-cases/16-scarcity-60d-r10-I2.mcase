      "guarded": true,
      "key": "K0138",
      "place": "grocery",
      "source": "told",
      "text": "Oskar told me about 18 crowns missing from the grocery till; it went missing from about 17:30 on Day 6 to 08:30 on Day 8.",
      "time": 8249,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "ida",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0139",
      "place": null,
      "source": "told",
      "text": "Oskar told me Tomas refused Ida a loan around 18:45 on Day 6.",
      "time": 8330,
      "topics": [
