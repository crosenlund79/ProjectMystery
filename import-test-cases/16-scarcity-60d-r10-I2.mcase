      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0129",
      "key": "K0083",
      "place": null,
      "source": "saw",
      "text": "I saw Agnes turn Ida down for a loan around 20:45 on Day 7.",
      "time": 9889,
      "topics": [
       "money",
       "person:agnes",
       "person:ida"
      ]
     },
     {
      "about": [
       "ida"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0084",
      "place": null,
      "source": "told",
      "text": "Agnes told me Ida has been short of money \u2014 asking around for money.",
      "time": 9889,
      "topics": [
       "money",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0085",
      "place": null,
      "source": "self",
      "text": "I couldn't make the rent to Tomas.",
      "time": 10560,
      "topics": [
       "money",
       "person:tomas"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0086",
      "place": "grocery",
      "source": "told",
      "text": "Agnes told me about 18 crowns missing from the grocery till; it went missing from about 18:00 on Day 6 to 09:00 on Day 8.",
