      ],
      "facts": [],
      "guarded": false,
      "key": "K0137",
      "place": null,
      "source": "told",
      "text": "Felix told me there's bad blood between Anton and Elias \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
