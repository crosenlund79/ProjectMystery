      "guarded": false,
      "in": "K0424",
      "key": "K0425",
      "place": null,
      "source": "self",
      "text": "On Day 12: from about 09:00 to 16:15 I was at the mill; around 16:18 I passed through Mill Road; around 16:24 I passed through the square; from about 16:30 to 07:15 I was at home, asleep for most of it; around 07:08 I passed through the square; around 07:14 I passed through Mill Road; from about 07:15 to 16:15 I was at the mill; around 16:20 I passed through Mill Road; around 16:26 I passed through the square; from about 16:30 to 19:00 I was at home; around 19:05 I passed through the square; from about 19:00 to 22:00 I was at the Lantern; around 22:02 I passed through the square; from about 22:00 to 07:00 I was at home, asleep for most of it.",
      "time": 16380,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "elias"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0426",
      "place": null,
      "source": "told",
      "text": "Anton told me there's bad blood between them and Elias \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:elias",
       "rumors"
      ]
     },
     {
      "about": [
       "felix",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0427",
      "place": null,
      "source": "self",
      "text": "Felix owes me 38 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:felix"
      ]
     },
     {
      "about": [
       "anton",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0428",
      "place": null,
      "source": "self",
      "text": "Anton couldn't pay me the rent.",
      "time": 10560,
      "topics": [
       "money",
       "person:anton"
      ]
     },
     {
      "about": [
       "ida",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0429",
      "place": null,
      "source": "self",
      "text": "Ida couldn't pay me the rent.",
      "time": 10560,
      "topics": [
       "money",
       "person:ida"
      ]
     },
     {
      "about": [
       "agnes",
       "ida"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0430",
      "place": null,
      "source": "told",
      "text": "Ida told me Agnes refused them a loan around 20:45 on Day 7.",
      "time": 9889,
      "topics": [
       "money",
       "person:agnes",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "tomas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0431",
      "place": null,
      "source": "self",
      "text": "Anton paid me back 40 crowns around 18:45 on Day 8.",
      "time": 11207,
      "topics": [
       "money",
       "person:anton"
      ]
     },
     {
      "about": [
       "agnes",
       "henrik"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0464",
      "key": "K0432",
      "place": null,
      "source": "told",
      "text": "Elias told me Henrik has been taking food on credit from Agnes (30 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:henrik",
       "rumors"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": true,
      "key": "K0433",
      "place": "grocery",
      "source": "told",
      "text": "Henrik told me about 18 crowns missing from the grocery till; it went missing from about 19:00 on Day 6 to 10:00 on Day 8.",
      "time": 8339,
      "topics": [
       "past",
       "rumors"
      ]
     },
