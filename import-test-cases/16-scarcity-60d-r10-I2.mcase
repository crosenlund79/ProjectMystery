      "place": "pub",
      "source": "saw",
      "text": "At the Lantern, from about 19:00 to 22:00 on Day 13, I saw Agnes, Anton, Clara, Felix, Ida, Tomas and Vera, coming and going; Clara and Felix were the worse for drink.",
      "time": 18419,
      "topics": [
       "window"
      ]
     }
