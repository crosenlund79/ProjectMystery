      "guarded": false,
      "in": "K0134",
      "key": "K0135",
      "place": null,
      "source": "self",
      "text": "On Day 12: from about 09:00 to 17:00 I was at the workshop; around 17:04 I passed through the square; from about 17:00 to 22:15 I was at the Lantern; around 22:13 I passed through the square; around 22:19 I passed through Mill Road; from about 22:30 to 08:15 I was at home, asleep for most of it; around 08:12 I passed through Mill Road; around 08:18 I passed through the square; from about 08:15 to 17:15 I was at the workshop; around 17:10 I passed through the square; from about 17:15 to 21:15 I was at the Lantern; around 21:09 I passed through the square; around 21:15 I passed through Mill Road; from about 21:15 to 07:00 I was at home, asleep for most of it.",
      "time": 16380,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "felix",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0136",
      "place": null,
      "source": "told",
      "text": "Tomas told me Felix owes them 38 crowns.",
