       "henrik"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0270",
      "place": null,
      "source": "self",
      "text": "I've been taking food on credit from Agnes; I owe 30 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
