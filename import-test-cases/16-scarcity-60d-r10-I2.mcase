      "members": [
       "K0384",
       "K0385"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Henrik and Ida owe Agnes money.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
