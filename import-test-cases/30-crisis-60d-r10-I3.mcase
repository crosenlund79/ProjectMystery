      "about": [
       "jonas",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0238",
      "place": null,
      "source": "self",
      "text": "Tomas and I have never got on \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
