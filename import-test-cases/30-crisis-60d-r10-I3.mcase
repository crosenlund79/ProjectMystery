      "key": "K0237",
      "place": null,
      "source": "self",
      "text": "On Day 14: from about 13:15 to 15:15 I was at the Drover's Rest; around 15:08 I passed through the square; around 15:14 I passed through Mill Road; from about 15:15 to 07:15 I was at home, asleep for most of it.",
      "time": 19514,
      "topics": [
       "whereabouts"
      ]
     },
