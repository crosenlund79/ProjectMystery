      "key": "K0589",
      "place": null,
      "source": "self",
      "text": "On Day 34: from about 19:00 to 22:00 I was at the Crooked Pike; around 22:07 I passed through the square; around 22:13 I passed through Mill Road; from about 22:15 to 07:15 I was at home, asleep for most of it.",
      "time": 48665,
      "topics": [
       "whereabouts"
      ]
