      "guarded": false,
      "in": "K0200",
      "key": "K0201",
      "place": null,
      "source": "self",
      "text": "On Day 34: from about 19:00 to 22:15 I was at the Crooked Pike; around 22:12 I passed through the square; around 22:14 I passed through Mill Road; from about 22:15 to 18:15 I was at home, asleep for most of it; around 18:10 I passed through Mill Road; around 18:12 I passed through the square; from about 18:15 to 22:00 I was at the Crooked Pike; after that it gets hazy \u2014 I'd had a fair bit to drink; around 22:07 I passed through the square; around 22:13 I passed through Mill Road; from about 22:15 to 07:15 I was at home, asleep for most of it.",
      "time": 48665,
      "topics": [
       "whereabouts"
      ]
     },
