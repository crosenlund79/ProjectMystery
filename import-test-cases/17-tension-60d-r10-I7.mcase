      "guarded": false,
      "in": "K0400",
      "key": "K0401",
      "place": null,
      "source": "self",
      "text": "On Day 34: from about 19:00 to 23:15 I was at the Crooked Pike; around 23:16 I passed through the square; from about 23:15 to 10:15 I was at home, asleep for most of it; around 10:14 I passed through the square; around 10:20 I passed through Mill Road; from about 10:30 to 11:15 I was at the Dunmore house; around 11:12 I passed through Mill Road; around 11:18 I passed through the square; from about 11:15 to 17:15 I was at home, asleep for most of it; around 17:15 I passed through the square; from about 17:15 to 23:15 I was at the Crooked Pike; around 23:16 I passed through the square; from about 23:15 to 07:15 I was at home, asleep for most of it.",
      "time": 48665,
      "topics": [
       "whereabouts"
      ]
     },
