      ]
     },
     {
      "about": [
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0973",
      "place": "workshop",
      "source": "saw",
      "text": "I saw the old blue hatchback (Margaret's) with a dented front bumper, a cracked headlight and flecks of white paint and wood splinters in the grille around 09:00 on Day 36.",
      "time": 50935,
      "topics": [
       "person:greta",
       "person:margaret",
       "vehicles"
      ]
     },
     {
      "about": [
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0974",
      "place": null,
      "source": "told",
      "text": "Margaret told me they had the old blue hatchback repaired around 09:00 on Day 36 and said: \"Hit a deer out on the ridge road a few nights back.\".",
      "time": 50935,
      "topics": [
       "person:greta",
       "person:margaret",
       "rumors",
       "vehicles"
      ]
     },
     {
      "about": [
       "margaret"
      ],
      "facts": [
       {
