      "facts": [],
      "guarded": false,
      "key": "K0977",
      "members": [
       "K0908",
       "K0912"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Ruth owes Agnes money.",
      "time": 9228,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
       "felix",
       "margaret",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0978",
      "members": [
       "K0910",
       "K0911"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Margaret and Ruth owe Felix money.",
      "time": 16375,
      "topics": [
       "money",
       "person:felix",
       "rumors"
      ]
     },
     {
      "about": [
