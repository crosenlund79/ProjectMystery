      "key": "K0902",
      "place": null,
      "source": "self",
      "text": "On Day 34: from about 19:00 to 21:00 I was at the Crooked Pike; around 21:03 I passed through the square; from about 21:00 to 21:15 I was at home, asleep for most of it; around 21:13 I passed through the square; around 21:19 I passed through Mill Road; from about 21:30 to 22:15 I was at the Vale house; around 22:15 I passed through Mill Road; around 22:21 I passed through the square; from about 22:30 to 07:15 I was at home, asleep for most of it.",
      "time": 48665,
      "topics": [
       "whereabouts"
      ]
     },
