       "K0925",
       "K0929",
       "K0934",
       "K0936",
       "K0940"
      ],
      "place": null,
      "source": "self",
      "text": "I asked Agnes, Felix, Marta and Selma for money a while ago, and they all said no.",
      "time": 41633,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "selma"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0980",
      "members": [
       "K0933",
       "K0961"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Selma and Viktor over the 282 crowns missing from the Pryce household savings tin.",
      "time": 40710,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "greta",
       "margaret",
       "vera"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0981",
      "members": [
       "K0938",
       "K0939"
      ],
      "place": null,
      "source": "told",
      "text": "I hear Greta and Margaret paid Vera back a while ago.",
      "time": 45168,
      "topics": [
       "money",
       "person:vera",
       "rumors"
      ]
     },
     {
