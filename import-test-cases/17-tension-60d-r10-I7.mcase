      "key": "K0306",
      "place": null,
      "source": "self",
      "text": "On Day 34: from about 19:00 to 22:15 I was at the Crooked Pike; around 22:17 I passed through the square; around 22:23 I passed through Mill Road; from about 22:30 to 16:15 I was at home, asleep for most of it; around 16:16 I passed through Mill Road; from about 16:15 to 20:15 I was at the square; from about 20:15 to 07:15 I was at home, asleep for most of it; around 07:11 I passed through Mill Road; from about 07:15 to 07:15 I was at the mill.",
      "time": 48665,
      "topics": [
       "whereabouts"
      ]
     },
