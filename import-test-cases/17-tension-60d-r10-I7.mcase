      "guarded": false,
      "key": "K0975",
      "place": "workshop",
      "source": "saw",
      "text": "I saw Margaret at the workshop around 09:00 on Day 36.",
      "time": 50939,
      "topics": [
       "person:margaret"
      ]
     },
     {
      "about": [
       "felix",
       "greta",
       "ruth",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0976",
      "members": [
       "K0906",
       "K0917",
       "K0918"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Greta, Ruth and Selma owe Felix money.",
      "time": null,
      "topics": [
       "money",
       "person:felix",
       "rumors"
      ]
     },
     {
      "about": [
