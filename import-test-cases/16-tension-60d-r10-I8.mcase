      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0174",
      "members": [
       "K0120",
       "K0128"
      ],
      "place": null,
      "source": "self",
      "text": "I asked Arvid and Lena for money a while ago, and they all said no.",
      "time": 63233,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "arvid",
