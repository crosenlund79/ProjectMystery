      "key": "K0924",
      "place": null,
      "source": "self",
      "text": "On Day 49: from about 18:30 to 19:15 I was at the Grey Heron; around 19:15 I passed through the square; around 19:17 I passed through Mill Road; from about 19:15 to 20:00 I was at home; around 20:05 I passed through Mill Road; around 20:07 I passed through the square; from about 20:15 to 21:30 I was at the Grey Heron.",
      "time": 70224,
      "topics": [
       "whereabouts"
      ]
     },
