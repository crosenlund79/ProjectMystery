      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0172",
      "members": [
       "K0117",
       "K0123"
      ],
      "place": null,
      "source": "saw",
      "text": "I saw Marta ask Elias and Tomas for money a while ago and get turned down.",
      "time": 61670,
      "topics": [
       "money",
       "person:marta"
      ]
     },
     {
