      "members": [
       "K0031",
       "K0040",
       "K0049",
       "K0053"
      ],
      "place": null,
      "source": "self",
      "text": "I asked Clara, Lena, Margaret and Oskar for money a while ago, and they all said no.",
      "time": 61011,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
