       "K0090",
       "K0091"
      ],
      "place": null,
      "source": "self",
      "text": "Arvid and Marta owe me money, and they're behind with it.",
      "time": null,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "arvid",
       "elias",
       "margaret",
       "marta",
