      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0173",
      "members": [
       "K0118",
       "K0124"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Elias paid Ruth back a while ago.",
      "time": 62453,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
