      "place": null,
      "source": "self",
      "text": "On Day 49: from about 18:30 to 21:30 I was at the Grey Heron.",
      "time": 70224,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "lena",
       "oskar"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0181",
      "place": null,
      "source": "told",
      "text": "Lena told me there's bad blood between them and Oskar \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:lena",
       "person:oskar",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "elias"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0182",
      "place": null,
      "source": "self",
      "text": "Arvid and I have never got on \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:arvid"
      ]
     },
     {
      "about": [
       "margaret",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0183",
      "place": null,
      "source": "told",
      "text": "Margaret told me there's bad blood between them and Marta \u2014 a dog that was never returned.",
      "time": null,
      "topics": [
       "conflicts",
       "person:margaret",
       "person:marta",
       "rumors"
      ]
     },
     {
      "about": [
       "oskar",
       "tomas"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0184",
      "place": null,
      "source": "told",
      "text": "Ruth told me Tomas has been taking food on credit from Oskar (20 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:oskar",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0185",
      "place": null,
      "source": "told",
