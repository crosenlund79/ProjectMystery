      "members": [
       "K0093",
       "K0095",
       "K0100",
       "K0101",
       "K0103",
       "K0104",
       "K0112"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Arvid, Elias, Margaret, Marta and Tomas owe Oskar money \u2014 Elias and Margaret are behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:oskar",
       "rumors"
      ]
     },
     {
      "about": [
       "elias",
       "margaret",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0171",
      "members": [
       "K0097",
       "K0111"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Elias and Margaret owe Ruth money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
