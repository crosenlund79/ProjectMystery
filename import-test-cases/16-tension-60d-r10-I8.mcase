      ],
      "facts": [],
      "guarded": false,
      "key": "K0498",
      "place": null,
      "source": "self",
      "text": "Margaret and I have never got on \u2014 a dog that was never returned.",
      "time": null,
      "topics": [
       "conflicts",
       "person:margaret"
      ]
     },
     {
      "about": [
       "clara",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0499",
      "place": null,
      "source": "self",
      "text": "I owe Clara 78 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:clara"
      ]
     },
     {
      "about": [
       "lena",
       "oskar"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0500",
      "place": null,
      "source": "told",
      "text": "Oskar told me there's bad blood between Lena and them \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:lena",
       "person:oskar",
       "rumors"
      ]
     },
     {
      "about": [
       "oskar",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0589",
      "key": "K0501",
      "place": null,
      "source": "saw",
      "text": "I know Tomas has been taking food on credit from Oskar (20 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:oskar",
       "person:tomas"
      ]
     },
     {
      "about": [
       "arvid",
       "elias"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0502",
      "place": null,
      "source": "told",
      "text": "Oskar told me there's bad blood between Arvid and Elias \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:arvid",
       "person:elias",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0503",
      "place": null,
      "source": "told",
      "text": "Elias told me Arvid owes Clara 68 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:arvid",
       "person:clara",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0504",
      "place": null,
      "source": "self",
      "text": "I'm behind on paying Clara back \u2014 78 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:clara"
      ]
     },
     {
      "about": [
       "arvid",
       "clara"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0505",
      "place": null,
      "source": "told",
      "text": "Arvid told me they are behind on paying Clara back (68 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:arvid",
       "person:clara",
       "rumors"
      ]
     },
     {
      "about": [
