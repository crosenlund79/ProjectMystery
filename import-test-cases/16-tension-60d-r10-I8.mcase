       "K0394",
       "K0396",
       "K0400",
       "K0401"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Arvid, Clara, Elias, Marta and Tomas owe Oskar money \u2014 Elias is behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:oskar",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0485",
      "members": [
       "K0387",
       "K0389"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Arvid and Marta owe Clara money \u2014 Marta is behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:clara",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "elias",
       "marta",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0486",
      "members": [
       "K0397",
       "K0406",
       "K0409",
       "K0410"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Arvid, Clara, Elias and Marta owe Ruth money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "lena"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0487",
      "members": [
       "K0404",
       "K0412"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Arvid and Clara owe Lena money \u2014 Arvid is behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:lena",
       "rumors"
      ]
     },
     {
      "about": [
       "elias",
       "marta",
       "oskar"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0488",
      "members": [
       "K0417",
       "K0426",
       "K0436"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Marta was asking around for money a while ago, and Elias and Oskar said no.",
      "time": 61013,
      "topics": [
       "money",
       "person:marta",
       "rumors"
      ]
     },
     {
      "about": [
       "elias",
       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0489",
      "members": [
       "K0421",
       "K0437"
      ],
      "place": null,
      "source": "saw",
      "text": "I saw Elias pay Ruth back a while ago.",
      "time": 62453,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "lena"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0490",
      "members": [
       "K0429",
       "K0444"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Clara was asking around for money a while ago, and Arvid and Lena said no.",
      "time": 63233,
      "topics": [
       "money",
       "person:clara",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0491",
      "members": [
       "K0430",
       "K0431"
      ],
      "place": null,
      "source": "self",
      "text": "Arvid came to me for money a while ago, and I had to say no.",
      "time": 63893,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "marta"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0492",
      "members": [
       "K0432",
       "K0434",
       "K0435",
       "K0450",
       "K0457"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Arvid, Clara and Marta over the 997 crowns missing from the Dunmore household savings tin.",
      "time": 47940,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0493",
      "members": [
       "K0433",
       "K0445",
       "K0448"
      ],
      "place": null,
      "source": "self",
      "text": "I asked Arvid, Clara and Viktor for money a while ago, and they all said no.",
      "time": 64670,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
