       "K0130",
       "K0131"
      ],
      "place": null,
      "source": "self",
      "text": "Arvid and Margaret came to me for money a while ago, and I had to say no.",
      "time": 66052,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "arvid",
       "marta"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0177",
      "members": [
       "K0127",
       "K0138",
       "K0141",
       "K0144"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Arvid, Clara and Marta over the 997 crowns missing from the Dunmore household savings tin.",
