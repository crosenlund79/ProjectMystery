      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0198",
      "key": "K0159",
      "place": null,
      "source": "self",
      "text": "I turned Selma down when they asked me for a loan, around 10:45 on Day 10.",
      "time": 13610,
      "topics": [
       "money",
       "person:selma"
      ]
     },
     {
      "about": [
       "selma"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0198",
      "key": "K0160",
      "place": null,
      "source": "self",
      "text": "Selma came asking me for money, around 10:45 on Day 10. Times are hard for them.",
      "time": 13610,
      "topics": [
       "money",
       "person:selma"
      ]
     },
     {
      "about": [
