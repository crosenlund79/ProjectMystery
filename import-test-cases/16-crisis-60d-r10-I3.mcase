      "in": "K0146",
      "key": "K0147",
      "place": null,
      "source": "self",
      "text": "On Day 16: from about 05:00 to 07:00 I was at home; around 07:07 I passed through Mill Road; from about 07:15 to 16:15 I was at the mill; around 16:21 I passed through Mill Road; from about 16:30 to 17:15 I was at home; around 17:15 I passed through Mill Road; around 17:21 I passed through the square; from about 17:30 to 18:00 I was at the grocery; around 18:07 I passed through the square; from about 18:15 to 21:15 I was at the Crooked Pike; around 21:08 I passed through the square; around 21:14 I passed through Mill Road; from about 21:15 to 07:00 I was at home, asleep for most of it.",
      "time": 21900,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "agnes",
       "elias"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0196",
      "key": "K0148",
      "place": null,
      "source": "self",
      "text": "Agnes owes me 60 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "clara",
       "nora"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0197",
      "key": "K0149",
      "place": null,
      "source": "told",
      "text": "Nora told me Clara owes them 64 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:clara",
       "person:nora",
       "rumors"
      ]
     },
     {
      "about": [
