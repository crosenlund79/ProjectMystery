       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [],
      "facts": [],
      "guarded": true,
      "key": "K0473",
      "place": "home:okafor",
      "source": "told",
      "text": "Bruno told me about 617 crowns missing from the Okafor household savings tin; it went missing from about 08:00 on Day 9 to 08:00 on Day 16.",
      "time": 12000,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "bruno"
      ],
      "facts": [
       {
        "from": 22986,
        "hedged": true,
        "place": "square",
        "to": 22986,
        "who": "bruno"
       }
      ],
      "guarded": false,
      "key": "K0474",
      "place": "square",
      "source": "saw",
      "text": "I saw someone at the square around 23:00 on Day 16, heading toward the Vale house; I think it was Bruno, but it was dark.",
      "time": 22986,
      "topics": [
       "person:bruno",
       "window"
      ]
     },
     {
      "about": [],
      "facts": [],
      "guarded": false,
      "key": "K0475",
      "place": "home:carver",
      "source": "self",
      "text": "I found 113 crowns missing from the Carver household savings tin. It went missing from about 07:00 on Day 16 to 07:00 on Day 17.",
      "time": 22020,
      "topics": [
       "incident"
      ]
     },
     {
      "about": [
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0476",
      "members": [
       "K0432",
       "K0437"
      ],
      "place": null,
      "source": "self",
      "text": "Selma owes me money, and is behind with it.",
      "time": null,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "clara",
       "hedda",
       "nora"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0477",
      "members": [
       "K0435",
       "K0440",
       "K0441",
       "K0443"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Clara and Hedda owe Nora money \u2014 Clara is behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:nora",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "elias",
       "hedda",
       "nora"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0478",
      "members": [
       "K0439",
       "K0452",
       "K0456"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Agnes, Hedda and Nora owe Elias money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:elias",
       "rumors"
      ]
     },
     {
