      ],
      "facts": [],
      "guarded": false,
      "in": "K0196",
      "key": "K0150",
      "place": null,
      "source": "self",
      "text": "Nora owes me 82 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:nora"
      ]
     },
     {
      "about": [
       "elias",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0196",
      "key": "K0151",
      "place": null,
      "source": "self",
      "text": "Tomas owes me 58 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:tomas"
      ]
     },
     {
      "about": [
       "selma",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0152",
      "place": null,
      "source": "told",
      "text": "Selma told me they owe Tomas 73 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:selma",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "hedda",
       "tomas"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0153",
      "place": null,
      "source": "told",
      "text": "Selma told me there's bad blood between Hedda and Tomas \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:hedda",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "elias",
       "selma"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0154",
      "place": null,
      "source": "self",
      "text": "I had to let Selma go from the mill.",
      "time": 6240,
      "topics": [
       "money",
       "person:selma"
      ]
     },
     {
      "about": [
       "agnes",
       "elias"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0196",
      "key": "K0155",
      "place": null,
      "source": "self",
      "text": "Agnes owes me 60 crowns and is late paying.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "clara",
       "nora"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0197",
      "key": "K0156",
      "place": null,
      "source": "saw",
      "text": "I know Clara has been taking food on credit from Nora (32 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:clara",
       "person:nora"
      ]
     },
     {
      "about": [
       "selma",
       "tomas"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0157",
      "place": null,
      "source": "told",
      "text": "Hedda told me Selma is behind on paying Tomas back (73 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:selma",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
