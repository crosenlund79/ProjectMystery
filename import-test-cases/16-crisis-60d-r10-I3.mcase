      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0109",
      "place": null,
      "source": "self",
      "text": "I asked Ida for a loan around 21:00 on Day 11. They said no.",
      "time": 15653,
      "topics": [
       "money",
       "person:ida"
      ]
     },
     {
      "about": [
       "clara",
       "hedda"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0142",
      "key": "K0110",
      "place": null,
      "source": "self",
      "text": "I turned Hedda down when they asked me for a loan, around 10:00 on Day 12.",
      "time": 16435,
      "topics": [
       "money",
       "person:hedda"
      ]
     },
     {
      "about": [
       "hedda"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0142",
      "key": "K0111",
      "place": null,
      "source": "self",
      "text": "Hedda came asking me for money, around 10:00 on Day 12. Times are hard for them.",
      "time": 16435,
      "topics": [
       "money",
       "person:hedda"
      ]
     },
     {
      "about": [
       "ida"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0112",
      "place": null,
      "source": "told",
      "text": "Nora told me Ida has been short of money \u2014 cannot pay for food.",
      "time": 16426,
      "topics": [
       "money",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "elias"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0113",
      "place": null,
      "source": "self",
      "text": "I couldn't make the rent to Elias.",
      "time": 20640,
      "topics": [
       "money",
       "person:elias"
      ]
     },
     {
      "about": [
       "nora"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0114",
      "place": null,
      "source": "saw",
      "text": "I saw Nora turn someone down for credit at the grocery around 08:45 on Day 15.",
      "time": 20688,
      "topics": [
