      "facts": [],
      "guarded": false,
      "key": "K0479",
      "members": [
       "K0442",
       "K0447"
      ],
      "place": null,
      "source": "told",
      "text": "I hear Agnes and Ida paid Elias back a while ago.",
      "time": 13967,
      "topics": [
       "money",
       "person:elias",
       "rumors"
      ]
     },
     {
