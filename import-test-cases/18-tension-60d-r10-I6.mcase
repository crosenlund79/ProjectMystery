      "facts": [],
      "guarded": true,
      "key": "K0751",
      "place": null,
      "source": "told",
      "text": "Hedda told me there's bad blood between Emil and Henrik \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
