      ],
      "facts": [],
      "guarded": false,
      "key": "K0889",
      "place": null,
      "source": "told",
      "text": "Anton told me there's bad blood between them and Arvid \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
