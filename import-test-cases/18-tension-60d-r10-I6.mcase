      "key": "K0345",
      "members": [
       "K0258",
       "K0290"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Agnes and Viktor owe Lena money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:lena",
       "rumors"
      ]
     },
     {
