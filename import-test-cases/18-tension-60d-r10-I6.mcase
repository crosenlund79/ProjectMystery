       "K0049",
       "K0053",
       "K0101"
      ],
      "place": null,
      "source": "self",
      "text": "Arvid, Clara, Emil, Henrik and Viktor owe me money; Arvid and Emil are behind with it.",
      "time": null,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "clara",
       "margaret",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0131",
      "members": [
       "K0025",
       "K0026",
       "K0047",
       "K0048",
       "K0054",
       "K0055"
      ],
      "place": null,
      "source": "self",
      "text": "Clara, Margaret and Viktor came to me for money a while ago, and I had to say no.",
      "time": 27111,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "emil",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0132",
      "members": [
       "K0028",
       "K0045"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Emil and Viktor over the 32 crowns missing from the grocery till.",
      "time": 26628,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "clara",
       "emil",
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0133",
      "members": [
       "K0029",
       "K0035",
       "K0100"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Arvid was asking around for money a while ago, and Clara, Emil and Viktor said no.",
      "time": 27106,
      "topics": [
       "money",
       "person:arvid",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "lena",
       "margaret",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0134",
      "members": [
       "K0050",
       "K0057",
       "K0072"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Arvid, Margaret and Viktor owe Lena money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:lena",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "henrik",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0135",
      "members": [
       "K0064",
       "K0096",
       "K0107"
      ],
      "place": null,
      "source": "self",
      "text": "Arvid, Henrik and Viktor have paid me back lately.",
      "time": 32206,
      "topics": [
       "money"
      ]
     },
