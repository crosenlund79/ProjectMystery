      "text": "At the Drover's Rest, from about 17:00 to 23:00 on Day 24, I saw Agnes, Anton, Arvid, Emil, Hedda, Lena, Margaret and Viktor, coming and going; Arvid, Emil, Hedda and Lena were the worse for drink.",
      "time": 34139,
      "topics": [
       "window"
      ]
     },
     {
      "about": [
       "agnes",
       "arvid",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0747",
      "members": [
       "K0719",
       "K0731"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Arvid and Viktor have been paying Agnes back lately.",
      "time": 33655,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     }
    ],
