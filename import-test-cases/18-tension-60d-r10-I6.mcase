      ]
     },
     {
      "about": [
       "anton",
       "arvid"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0142",
      "place": null,
      "source": "self",
      "text": "Arvid and I have never got on \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:arvid"
      ]
     },
     {
      "about": [
       "anton",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0143",
      "place": null,
      "source": "self",
      "text": "Viktor owes me 40 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:viktor"
      ]
     },
     {
      "about": [
       "emil",
       "henrik"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0144",
      "place": null,
      "source": "told",
      "text": "Henrik told me there's bad blood between Emil and them \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:emil",
       "person:henrik",
       "rumors"
      ]
     },
     {
      "about": [
