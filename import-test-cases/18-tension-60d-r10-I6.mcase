       "K0158",
       "K0175",
       "K0176"
      ],
      "place": null,
      "source": "self",
      "text": "Clara and Margaret came to me for money a while ago, and I had to say no.",
      "time": 25789,
      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "emil"
      ],
      "era": "earlier",
      "facts": [],
