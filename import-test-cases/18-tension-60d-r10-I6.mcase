      "key": "K0240",
      "members": [
       "K0160",
       "K0170"
      ],
      "place": null,
      "source": "told",
      "text": "People have been pointing at Emil over the 467 crowns missing from the Holm household savings tin.",
      "time": 21900,
      "topics": [
