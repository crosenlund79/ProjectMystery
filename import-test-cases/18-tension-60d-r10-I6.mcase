       "henrik",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0237",
      "members": [
       "K0148",
       "K0149",
       "K0150",
       "K0181"
      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Arvid, Emil, Henrik and Viktor owe Agnes money.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "emil",
       "lena"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0238",
      "members": [
       "K0152",
       "K0153"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Agnes and Emil owe Lena money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:lena",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "margaret"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0239",
      "members": [
