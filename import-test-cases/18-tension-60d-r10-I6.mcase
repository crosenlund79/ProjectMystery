      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0343",
      "key": "K0253",
      "place": null,
      "source": "told",
      "text": "Agnes told me they owe Anton 20 crowns.",
      "time": 2630,
      "topics": [
