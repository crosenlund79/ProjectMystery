       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0145",
      "place": null,
      "source": "told",
      "text": "Henrik told me there's bad blood between them and Viktor \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:henrik",
       "person:viktor",
       "rumors"
      ]
     },
     {
