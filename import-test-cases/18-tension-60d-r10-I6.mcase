      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0041",
      "place": null,
      "source": "self",
      "text": "I asked Viktor for a loan around 12:45 on Day 21. They said no.",
      "time": 29568,
      "topics": [
       "money",
       "person:viktor"
      ]
     },
     {
      "about": [
       "viktor"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0042",
      "place": "pub",
      "source": "told",
      "text": "Clara told me Viktor had something to do with 52 crowns missing from the till at the Drover's Rest.",
      "time": 27299,
      "topics": [
       "past",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0043",
      "place": "pub",
      "source": "told",
      "text": "Arvid told me about the back door of the Drover's Rest forced, around 18:15 on Day 20.",
      "time": 28453,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
      "about": [],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0044",
      "place": "grocery",
      "source": "told",
      "text": "Henrik told me about 32 crowns missing from the grocery till; it went missing from about 10:45 to 17:00 on Day 19.",
      "time": 26568,
      "topics": [
       "past",
       "rumors"
      ]
     },
     {
