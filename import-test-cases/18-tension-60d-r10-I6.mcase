       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0251",
      "place": null,
      "source": "told",
      "text": "Anton told me Viktor owes them 40 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:anton",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "emil",
       "henrik"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0252",
      "place": null,
      "source": "told",
      "text": "Agnes told me there's bad blood between Emil and Henrik \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:emil",
       "person:henrik",
       "rumors"
      ]
     },
     {
