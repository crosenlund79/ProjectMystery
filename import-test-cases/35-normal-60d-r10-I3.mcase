       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0149",
      "place": null,
      "source": "self",
      "text": "I've been taking food on credit from Selma; I owe 32 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:selma"
      ]
     },
     {
      "about": [
       "jonas",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0150",
      "place": null,
      "source": "self",
      "text": "I'm behind on paying Selma back \u2014 32 crowns.",
      "time": null,
      "topics": [
