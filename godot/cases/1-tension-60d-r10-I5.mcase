      "key": "K0108",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 21:15 I was at the Drover's Rest; around 21:09 I passed through the square; from about 21:15 to 07:15 I was at home, asleep for most of it; from about 07:15 to 07:15 I was at the square; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
