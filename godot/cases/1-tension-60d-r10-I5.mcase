      ],
      "place": "pub",
      "source": "saw",
      "text": "At the Drover's Rest, from about 17:00 to 23:00 on Day 18, I saw Agnes, Emil, Hedda, Ida, Margaret, Tomas and Viktor, coming and going; Agnes, Emil, Margaret and Viktor were the worse for drink.",
      "time": 25499,
      "topics": [
       "window"
      ]
     }
    ],
    "style": "smooth"
   },
   "hedda": {
    "evasive_topics": [
