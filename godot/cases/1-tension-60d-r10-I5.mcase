        "place": "home:morrow",
        "to": 26356,
        "who": "hedda"
       }
      ],
      "guarded": false,
      "in": "K0226",
      "key": "K0227",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 23:15 I was at the Drover's Rest; around 23:10 I passed through the square; from about 23:15 to 07:15 I was at home, asleep for most of it.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "tomas",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0228",
      "place": null,
      "source": "told",
      "text": "Tomas told me there's bad blood between them and Viktor \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:tomas",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "hedda"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0229",
      "place": null,
      "source": "self",
      "text": "Clara owes me 34 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:clara"
      ]
     },
     {
      "about": [
       "jonas",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0280",
      "key": "K0230",
      "place": null,
      "source": "told",
      "text": "Viktor told me Jonas owes them 63 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:jonas",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0231",
      "place": null,
      "source": "told",
      "text": "Greta told me there's bad blood between Agnes and them \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:agnes",
       "person:greta",
       "rumors"
      ]
     },
     {
      "about": [
       "ida",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0232",
      "place": null,
      "source": "told",
      "text": "Greta told me there's bad blood between Ida and Margaret \u2014 a broken engagement.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ida",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
       "jonas",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0280",
      "key": "K0233",
      "place": null,
      "source": "told",
      "text": "Jonas told me they are behind on paying Viktor back (63 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:jonas",
       "person:viktor",
       "rumors"
      ]
     },
     {
      "about": [
       "ida",
       "jonas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0234",
      "place": null,
      "source": "told",
      "text": "Tomas told me Jonas owes Ida 45 crowns.",
      "time": 4195,
      "topics": [
       "money",
       "person:ida",
       "person:jonas",
       "rumors"
      ]
     },
     {
      "about": [
       "margaret",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0281",
      "key": "K0235",
      "place": null,
      "source": "told",
      "text": "Clara told me Tomas has been taking food on credit from Margaret (32 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:margaret",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes"
