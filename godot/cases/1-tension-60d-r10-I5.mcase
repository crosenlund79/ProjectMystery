       }
      ],
      "guarded": false,
      "in": "K0479",
      "key": "K0480",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 22:15 I was at the Drover's Rest; around 22:11 I passed through the square; around 22:17 I passed through Mill Road; from about 22:15 to 07:15 I was at home, asleep for most of it.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0481",
      "place": null,
      "source": "told",
      "text": "Agnes told me there's bad blood between them and Greta \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:agnes",
       "person:greta",
       "rumors"
      ]
     },
     {
      "about": [
       "tomas",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0482",
      "place": null,
      "source": "self",
      "text": "Viktor and I have never got on \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:viktor"
      ]
     },
     {
      "about": [
       "ida",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0483",
      "place": null,
      "source": "told",
      "text": "Ida told me there's bad blood between them and Margaret \u2014 a broken engagement.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ida",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
