      ],
      "place": "pub",
      "source": "saw",
      "text": "At the Drover's Rest, from about 19:00 to 22:00 on Day 18, I saw Agnes, Emil, Greta, Hedda, Ida, Margaret and Viktor, coming and going; Agnes, Emil, Margaret and Viktor were the worse for drink.",
      "time": 25619,
      "topics": [
       "window"
      ]
     }
    ],
    "style": "smooth"
   },
   "viktor": {
    "evasive_topics": [],
    "goodwill": 3,
    "items": [
     {
      "about": [
       "viktor"
      ],
      "facts": [
       {
        "from": 25643,
        "hedged": false,
        "place": "pub",
        "to": 25809,
        "who": "viktor"
       },
       {
        "from": 25815,
        "hedged": false,
        "place": "road",
        "to": 25820,
