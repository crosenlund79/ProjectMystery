      ],
      "guarded": false,
      "in": "K0284",
      "key": "K0285",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 22:15 I was at the Drover's Rest; around 22:13 I passed through the square; from about 22:15 to 07:15 I was at home, asleep for most of it.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "ida",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0286",
      "place": null,
      "source": "self",
      "text": "Margaret and I have never got on \u2014 a broken engagement.",
      "time": null,
      "topics": [
       "conflicts",
       "person:margaret"
      ]
     },
     {
      "about": [
