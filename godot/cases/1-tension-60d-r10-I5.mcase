       "K0227"
      ],
      "place": null,
      "source": "self",
      "text": "On Day 18, from about 19:30 I was at the Drover's Rest; home around 23:15 and to bed.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "hedda"
      ],
      "facts": [
       {
        "from": 25643,
        "hedged": false,
        "place": "pub",
