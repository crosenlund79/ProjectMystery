      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0603",
      "members": [
       "K0564",
       "K0566"
      ],
      "place": null,
      "source": "told",
      "text": "I hear Clara was asking around for money a while ago, and Margaret said no.",
      "time": 17776,
      "topics": [
       "money",
       "person:clara",
       "rumors"
      ]
     },
