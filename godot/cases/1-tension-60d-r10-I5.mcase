      "key": "K0002",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 21:15 I was at the Drover's Rest; around 21:17 I passed through the square; around 21:23 I passed through Mill Road; from about 21:30 to 07:15 I was at home, asleep for most of it.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
