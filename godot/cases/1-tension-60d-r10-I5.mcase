      "key": "K0602",
      "members": [
       "K0539",
       "K0557",
       "K0569"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Ida, Jonas and Tomas owe Margaret money.",
      "time": null,
      "topics": [
       "money",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
