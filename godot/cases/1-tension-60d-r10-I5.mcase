      "members": [
       "K0124",
       "K0130",
       "K0143"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Clara was asking around for money a while ago, and Margaret and Viktor said no.",
      "time": 17776,
      "topics": [
       "money",
       "person:clara",
       "rumors"
      ]
     },
