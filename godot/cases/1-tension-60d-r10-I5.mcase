      ],
      "facts": [],
      "guarded": false,
      "in": "K0601",
      "key": "K0535",
      "place": null,
      "source": "self",
      "text": "Jonas owes me 63 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:jonas"
      ]
     },
     {
      "about": [
       "clara",
       "hedda"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0536",
      "place": null,
      "source": "told",
      "text": "Margaret told me Clara owes Hedda 34 crowns.",
