      ],
      "facts": [],
      "guarded": false,
      "in": "K0527",
      "key": "K0484",
      "place": null,
      "source": "told",
      "text": "Viktor told me Jonas owes them 63 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:jonas",
       "person:viktor",
       "rumors"
      ]
     },
     {
