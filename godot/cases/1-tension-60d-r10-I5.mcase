        "to": 26350,
        "who": "viktor"
       },
       {
        "from": 26350,
        "hedged": false,
        "place": "road",
        "to": 26356,
        "who": "viktor"
       }
      ],
      "guarded": false,
      "key": "K0530",
      "members": [
       "K0531"
      ],
      "place": null,
      "source": "self",
      "text": "On Day 18, from about 19:30 I was at the Drover's Rest; along Mill Road around 22:15; after that it gets hazy \u2014 I'd had a fair bit to drink; home around 22:15 and to bed; on Day 19 back at Mill Road from about 07:15.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "viktor"
      ],
      "facts": [
       {
        "from": 25643,
        "hedged": false,
        "place": "pub",
        "to": 25809,
        "who": "viktor"
       },
       {
        "from": 25809,
        "hedged": false,
        "place": "square",
        "to": 25815,
        "who": "viktor"
       },
       {
        "from": 25815,
        "hedged": false,
        "place": "road",
        "to": 25820,
        "who": "viktor"
       },
       {
        "from": 25820,
        "hedged": false,
        "place": "home:kessler",
        "to": 26350,
        "who": "viktor"
       },
       {
        "from": 26350,
        "hedged": false,
        "place": "road",
        "to": 26356,
        "who": "viktor"
       }
      ],
      "guarded": false,
      "in": "K0530",
      "key": "K0531",
      "place": null,
      "source": "self",
      "text": "On Day 18: from about 19:30 to 22:15 I was at the Drover's Rest; around 22:09 I passed through the square; around 22:15 I passed through Mill Road; from about 22:15 to 07:15 I was at home, asleep for most of it; from about 07:15 to 07:15 I was at Mill Road; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 25643,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0532",
      "place": null,
      "source": "told",
      "text": "Agnes told me there's bad blood between them and Greta \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:agnes",
       "person:greta",
       "rumors"
      ]
     },
     {
      "about": [
       "tomas",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0533",
      "place": null,
      "source": "self",
      "text": "Tomas and I have never got on \u2014 something said at the pub years ago.",
      "time": null,
      "topics": [
       "conflicts",
       "person:tomas"
      ]
     },
     {
      "about": [
       "ida",
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0534",
      "place": null,
      "source": "told",
      "text": "Ida told me there's bad blood between them and Margaret \u2014 a broken engagement.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ida",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
