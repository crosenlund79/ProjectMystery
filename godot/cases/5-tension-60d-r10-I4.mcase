      "members": [
       "K0021",
       "K0022",
       "K0030",
       "K0045"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Lena, Margaret and Nora paid Ida back a while ago.",
      "time": 21349,
      "topics": [
       "money",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
