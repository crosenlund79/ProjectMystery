      ],
      "place": "pub",
      "source": "saw",
      "text": "At the Crooked Pike, from about 19:00 to 23:00 on Day 23, I saw Ida, Jonas, Lena, Margaret, Marta, Nora, Oskar, Selma and Vera, coming and going; Ida, Lena and Vera were the worse for drink.",
      "time": 32819,
      "topics": [
       "incident",
       "window"
      ]
     },
     {
      "about": [
       "margaret"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0086",
      "members": [
       "K0066",
       "K0067"
      ],
      "place": null,
      "source": "self",
      "text": "Margaret has come to me for money lately, and I had to say no.",
      "time": 32927,
      "topics": [
       "money"
      ]
     }
    ],
    "style": "nervous"
