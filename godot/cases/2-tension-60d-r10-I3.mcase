      "facts": [],
      "guarded": false,
      "key": "K0114",
      "place": null,
      "source": "self",
      "text": "Agnes and I have never got on \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:agnes"
      ]
     },
     {
