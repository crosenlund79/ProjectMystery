      "guarded": false,
      "key": "K0413",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 14:15 to 16:15 I was at home; around 16:14 I passed through the square; from about 16:15 to 23:15 I was at the Drover's Rest; around 23:12 I passed through the square; from about 23:15 to 07:15 I was at home, asleep for most of it.",
      "time": 32534,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "elias",
       "hedda"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0414",
      "place": null,
      "source": "told",
      "text": "Elias told me there's bad blood between they and Hedda \u2014 a broken engagement.",
      "time": null,
      "topics": [
