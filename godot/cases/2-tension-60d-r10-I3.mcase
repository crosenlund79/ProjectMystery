      ],
      "guarded": false,
      "key": "K0059",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 14:15 to 16:15 I was at the mill; around 16:08 I passed through Mill Road; around 16:14 I passed through the square; from about 16:15 to 17:15 I was at home; around 17:16 I passed through the square; from about 17:15 to 21:00 I was at the Drover's Rest; around 21:06 I passed through the square; from about 21:15 to 07:15 I was at home, asleep for most of it; from about 07:15 to 07:15 I was at the square; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 32534,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "anton",
       "hedda"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0060",
      "place": null,
      "source": "self",
      "text": "Hedda and I have never got on \u2014 a broken engagement.",
      "time": null,
      "topics": [
       "conflicts",
       "person:hedda"
      ]
     },
     {
      "about": [
       "agnes",
       "bruno"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0061",
      "place": null,
      "source": "told",
      "text": "Agnes told me there's bad blood between they and Bruno \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
