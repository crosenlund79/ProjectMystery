      "guarded": false,
      "key": "K0113",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 14:15 to 23:15 I was at the Drover's Rest; around 23:10 I passed through the square; around 23:16 I passed through Mill Road; from about 23:15 to 07:15 I was at home, asleep for most of it.",
      "time": 32534,
