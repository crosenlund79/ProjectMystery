      "guarded": false,
      "key": "K0521",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 14:15 to 17:00 I was at the grocery; around 17:02 I passed through the square; from about 17:00 to 19:15 I was at the Drover's Rest; around 19:17 I passed through the square; from about 19:15 to 20:15 I was at home; around 20:12 I passed through the square; from about 20:15 to 22:15 I was at the Drover's Rest; after that it gets hazy \u2014 I'd had a fair bit to drink; around 22:09 I passed through the square; from about 22:15 to 07:15 I was at home, asleep for most of it.",
      "time": 32534,
      "topics": [
       "whereabouts"
      ]
     },
