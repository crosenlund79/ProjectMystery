       "felix",
       "margaret"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0391",
      "place": null,
      "source": "told",
      "text": "Viktor told me there's bad blood between Felix and Margaret \u2014 a dog that was never returned.",
      "time": null,
      "topics": [
       "conflicts",
       "person:felix",
       "person:margaret",
       "rumors"
      ]
     },
