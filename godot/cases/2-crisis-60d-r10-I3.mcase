       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0109",
      "place": null,
      "source": "told",
      "text": "Ida told me Henrik owes them 36 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:henrik",
       "person:ida",
       "rumors"
      ]
     },
     {
