      ],
      "facts": [],
      "guarded": false,
      "key": "K0110",
      "place": null,
      "source": "self",
      "text": "I owe Ida 62 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ida"
      ]
     },
     {
      "about": [
