       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0108",
      "place": null,
      "source": "told",
      "text": "Ida told me Hedda owes them 45 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:hedda",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
