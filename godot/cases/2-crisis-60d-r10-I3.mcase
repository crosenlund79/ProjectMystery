        "who": "jonas"
       }
      ],
      "guarded": false,
      "key": "K0106",
      "place": null,
      "source": "self",
      "text": "On Day 5: from about 14:15 to 23:15 I was at the Crooked Pike; around 23:13 I passed through the square; around 23:19 I passed through Mill Road; from about 23:30 to 07:15 I was at home, asleep for most of it.",
      "time": 6621,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "henrik",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0107",
      "place": null,
      "source": "told",
      "text": "Henrik told me there's bad blood between they and Selma \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:henrik",
       "person:selma",
       "rumors"
      ]
     },
     {
      "about": [
