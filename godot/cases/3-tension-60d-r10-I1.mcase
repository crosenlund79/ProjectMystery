      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0402",
      "place": null,
      "source": "saw",
      "text": "I saw someone turn Daniel down for a loan around 21:00 on Day 6.",
      "time": 8454,
      "topics": [
       "money",
       "person:daniel"
      ]
     },
     {
      "about": [
       "bruno"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0403",
      "place": null,
      "source": "told",
      "text": "Clara told me Bruno refused someone a loan around 21:00 on Day 6.",
      "time": 8454,
      "topics": [
       "money",
       "person:bruno",
       "rumors"
      ]
     },
     {
      "about": [
