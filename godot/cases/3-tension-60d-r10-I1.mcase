       "ida"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0399",
      "place": null,
      "source": "told",
      "text": "Marta told me Bruno owes Ida 46 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:bruno",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
