      "guarded": false,
      "in": "K0393",
      "key": "K0394",
      "place": null,
      "source": "self",
      "text": "On Day 9: from about 09:00 to 16:15 I was at home, asleep for most of it; around 16:15 I passed through the square; from about 16:15 to 17:15 I was at the clinic; around 17:11 I passed through the square; from about 17:15 to 08:15 I was at home, asleep for most of it; around 08:13 I passed through the square; around 08:15 I passed through Mill Road; from about 08:15 to 14:15 I was at the mill; around 14:13 I passed through Mill Road; around 14:15 I passed through the square; from about 14:15 to 19:15 I was at home, asleep for most of it; around 19:15 I passed through the square; from about 19:15 to 07:00 I was at home, asleep for most of it.",
      "time": 12060,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "nora",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0395",
      "place": null,
      "source": "self",
      "text": "Ruth and I have never got on \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ruth"
      ]
     },
     {
      "about": [
       "nora",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0396",
      "place": null,
      "source": "self",
      "text": "I owe Viktor 35 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:viktor"
      ]
     },
     {
      "about": [
       "bruno",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0397",
      "place": null,
      "source": "told",
      "text": "Clara told me there's bad blood between Bruno and Marta \u2014 a dog that was never returned.",
      "time": null,
      "topics": [
       "conflicts",
       "person:bruno",
       "person:marta",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "viktor"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0398",
      "place": null,
      "source": "told",
      "text": "Bruno told me there's bad blood between Anton and Viktor \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton",
       "person:viktor",
       "rumors"
      ]
     },
     {
