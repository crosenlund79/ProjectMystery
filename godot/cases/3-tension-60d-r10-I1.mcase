      "guarded": false,
      "in": "K0509",
      "key": "K0510",
      "place": null,
      "source": "self",
      "text": "On Day 9: from about 09:00 to 17:15 I was at home, asleep for most of it; around 17:17 I passed through Mill Road; around 17:23 I passed through the square; from about 17:30 to 23:15 I was at the Grey Heron; around 23:12 I passed through the square; around 23:18 I passed through Mill Road; from about 23:30 to 17:15 I was at home, asleep for most of it; around 17:18 I passed through Mill Road; around 17:24 I passed through the square; from about 17:30 to 23:00 I was at the Grey Heron; around 23:04 I passed through the square; around 23:06 I passed through Mill Road; from about 23:15 to 07:00 I was at home, asleep for most of it.",
      "time": 12060,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "nora",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0511",
      "place": null,
      "source": "told",
      "text": "Nora told me there's bad blood between them and Ruth \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:nora",
       "person:ruth",
       "rumors"
      ]
     },
     {
      "about": [
       "bruno",
       "marta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0512",
      "place": null,
      "source": "told",
      "text": "Bruno told me there's bad blood between them and Marta \u2014 a dog that was never returned.",
      "time": null,
      "topics": [
       "conflicts",
       "person:bruno",
       "person:marta",
       "rumors"
      ]
     },
     {
      "about": [
       "anton",
       "viktor"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0513",
      "place": null,
      "source": "self",
      "text": "Anton and I have never got on \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:anton"
      ]
     },
     {
      "about": [
       "bruno",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0514",
      "place": null,
      "source": "told",
      "text": "Ida told me Bruno owes them 46 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:bruno",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "nora",
       "viktor"
      ],
      "facts": [],
