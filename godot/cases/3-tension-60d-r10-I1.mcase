      ],
      "facts": [],
      "guarded": false,
      "key": "K0005",
      "place": null,
      "source": "self",
      "text": "Viktor and I have never got on \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:viktor"
      ]
     },
