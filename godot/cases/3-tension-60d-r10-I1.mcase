      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0404",
      "place": null,
      "source": "self",
      "text": "I asked Daniel for a loan around 12:45 on Day 7. They said no.",
      "time": 9410,
      "topics": [
       "money",
       "person:daniel"
      ]
     },
     {
      "about": [
