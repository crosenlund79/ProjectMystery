      "facts": [],
      "guarded": false,
      "key": "K0401",
      "place": null,
      "source": "self",
      "text": "I paid Viktor back the 35 crowns I owed, around 17:00 on Day 5.",
      "time": 6774,
      "topics": [
       "money",
       "person:viktor"
      ]
     },
     {
      "about": [
