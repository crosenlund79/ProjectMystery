      ],
      "place": "pub",
      "source": "saw",
      "text": "At the Grey Heron, from about 20:00 to 22:00 on Day 10, I saw Anton, Bruno, Clara, Daniel, Emil, Ida, Ruth and Viktor, coming and going; Anton, Daniel and Ida were the worse for drink.",
      "time": 14159,
      "topics": [
       "window"
      ]
     }
    ],
