       "ruth"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0405",
      "place": null,
      "source": "self",
      "text": "I couldn't make the rent to Ruth.",
      "time": 10560,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
       "daniel",
       "nora"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0406",
      "place": null,
      "source": "self",
      "text": "I've been taking food on credit from Daniel; I owe 40 crowns.",
