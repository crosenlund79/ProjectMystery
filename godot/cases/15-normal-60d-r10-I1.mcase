      "in": "K0120",
      "key": "K0121",
      "place": null,
      "source": "self",
      "text": "On Day 47: from about 21:00 to 22:15 I was at the Grey Heron; around 22:10 I passed through the square; around 22:12 I passed through Mill Road; from about 22:15 to 08:15 I was at home, asleep for most of it; around 08:09 I passed through Mill Road; around 08:11 I passed through the square; from about 08:15 to 09:15 I was at the grocery; after that it gets hazy \u2014 I'd had a fair bit to drink; around 09:13 I passed through the square; around 09:15 I passed through Mill Road; from about 09:15 to 10:15 I was at the mill; around 10:14 I passed through Mill Road; from about 10:15 to 11:15 I was at the Pryce house; around 11:11 I passed through Mill Road; from about 11:15 to 11:45 I was at home.",
      "time": 67499,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "bruno",
       "daniel"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0122",
      "place": null,
      "source": "told",
      "text": "Daniel told me Bruno owes them 45 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:bruno",
       "person:daniel",
       "rumors"
      ]
     },
