       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0151",
      "key": "K0127",
      "place": null,
      "source": "told",
      "text": "Ruth told me Bruno has been taking food on credit from them (12 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:bruno",
       "person:ruth",
       "rumors"
      ]
