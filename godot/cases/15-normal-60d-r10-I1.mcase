      ],
      "facts": [],
      "guarded": false,
      "key": "K0126",
      "place": null,
      "source": "self",
      "text": "I've been taking food on credit from Ruth; I owe 40 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ruth"
      ]
     },
     {
      "about": [
