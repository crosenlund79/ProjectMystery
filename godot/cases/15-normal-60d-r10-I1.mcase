      "guarded": false,
      "in": "K0154",
      "key": "K0155",
      "place": null,
      "source": "self",
      "text": "On Day 47: from about 21:00 to 22:15 I was at the Grey Heron; around 22:15 I passed through the square; around 22:21 I passed through Mill Road; from about 22:30 to 08:15 I was at home, asleep for most of it; around 08:19 I passed through Mill Road; around 08:25 I passed through the square; from about 08:30 to 11:45 I was at the workshop; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 67499,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "clara",
       "ruth"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0156",
      "place": null,
      "source": "told",
      "text": "Clara told me there's bad blood between them and Ruth \u2014 a quarrel over a boundary fence.",
