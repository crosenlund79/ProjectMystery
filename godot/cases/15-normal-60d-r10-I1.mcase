      "key": "K0052",
      "place": null,
      "source": "self",
      "text": "On Day 47: from about 21:00 to 00:15 I was at the Grey Heron; around 00:16 I passed through the square; from about 00:15 to 08:15 I was at home, asleep for most of it; around 08:14 I passed through the square; from about 08:15 to 09:15 I was at the grocery; around 09:11 I passed through the square; from about 09:15 to 11:15 I was at home; around 11:13 I passed through the square; from about 11:15 to 11:45 I was at the Grey Heron.",
      "time": 67499,
      "topics": [
       "whereabouts"
      ]
     },
