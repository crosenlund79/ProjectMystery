      "guarded": false,
      "in": "K0375",
      "key": "K0376",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 09:00 to 16:15 I was at the mill; around 16:09 I passed through Mill Road; around 16:15 I passed through the square; from about 16:15 to 07:15 I was at home, asleep for most of it; around 07:18 I passed through the square; around 07:24 I passed through Mill Road; from about 07:30 to 16:15 I was at the mill; around 16:19 I passed through Mill Road; around 16:25 I passed through the square; from about 16:30 to 19:00 I was at home; around 19:05 I passed through the square; from about 19:00 to 22:15 I was at the Drover's Rest; around 22:16 I passed through the square; from about 22:15 to 07:00 I was at home, asleep for most of it.",
      "time": 32220,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "ida",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0377",
      "place": null,
      "source": "self",
      "text": "Ida and I have never got on \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ida"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0378",
      "place": null,
      "source": "told",
      "text": "Arvid told me Agnes owes Greta 46 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:greta",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0379",
      "place": null,
      "source": "told",
      "text": "Greta told me Agnes is behind on paying them back (46 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:greta",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0380",
      "place": null,
      "source": "self",
      "text": "Agnes owes me 40 crowns and is late paying.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
