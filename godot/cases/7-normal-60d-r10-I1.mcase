      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0372",
      "members": [
       "K0352",
       "K0354"
      ],
      "place": null,
      "source": "told",
      "text": "I hear Agnes was asking around for money a while ago, and Felix and Greta said no.",
      "time": 27080,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0373",
      "members": [
       "K0356",
       "K0357"
      ],
      "place": null,
      "source": "saw",
      "text": "I've seen Agnes paying Selma back lately.",
      "time": 31487,
      "topics": [
       "money",
       "person:selma"
      ]
     },
     {
