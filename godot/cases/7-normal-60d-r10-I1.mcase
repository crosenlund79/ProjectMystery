      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0381",
      "place": null,
      "source": "self",
      "text": "Nora paid me back 40 crowns around 10:00 on Day 19.",
      "time": 26514,
      "topics": [
