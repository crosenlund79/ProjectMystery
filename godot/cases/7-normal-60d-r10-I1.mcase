      "in": "K0210",
      "key": "K0211",
      "place": null,
      "source": "self",
      "text": "On Day 23: from about 09:00 to 10:15 I was at the grocery; around 10:14 I passed through the square; around 10:20 I passed through Mill Road; from about 10:30 to 11:15 I was at home; around 11:20 I passed through Mill Road; around 11:26 I passed through the square; from about 11:30 to 23:00 I was at the Drover's Rest; around 23:02 I passed through the square; around 23:08 I passed through Mill Road; from about 23:15 to 11:15 I was at home, asleep for most of it; around 11:15 I passed through Mill Road; around 11:21 I passed through the square; from about 11:30 to 23:15 I was at the Drover's Rest; around 23:17 I passed through the square; around 23:23 I passed through Mill Road; from about 23:30 to 07:00 I was at home, asleep for most of it.",
      "time": 32220,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0248",
      "key": "K0212",
      "place": null,
      "source": "self",
      "text": "Agnes owes me 46 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "ida",
       "selma"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0213",
      "place": null,
      "source": "told",
      "text": "Nora told me there's bad blood between Ida and Selma \u2014 a quarrel over a boundary fence.",
      "time": null,
      "topics": [
       "conflicts",
       "person:ida",
       "person:selma",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0248",
      "key": "K0214",
      "place": null,
      "source": "self",
      "text": "Agnes owes me 46 crowns and is late paying.",
      "time": null,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "agnes",
       "selma"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0215",
      "place": null,
      "source": "told",
      "text": "Agnes told me they are behind on paying Selma back (40 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
       "person:selma",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes",
       "bruno"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": true,
      "key": "K0216",
      "place": null,
      "source": "told",
      "text": "Nora told me Bruno refused Agnes a loan around 09:30 on Day 14.",
      "time": 19285,
      "topics": [
       "money",
       "person:agnes",
       "person:bruno",
       "rumors"
      ]
     },
     {
      "about": [
       "agnes"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": true,
      "key": "K0217",
      "place": null,
      "source": "told",
      "text": "Nora told me Agnes has been short of money \u2014 asking around for money.",
      "time": 17029,
      "topics": [
       "money",
       "person:agnes",
       "rumors"
      ]
     },
     {
      "about": [
       "greta",
       "nora"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0218",
      "place": null,
      "source": "self",
      "text": "Nora owes me 63 crowns.",
      "time": 26453,
      "topics": [
       "money",
       "person:nora"
      ]
     },
     {
      "about": [
       "agnes",
       "greta"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0249",
      "key": "K0219",
      "place": null,
      "source": "self",
      "text": "I turned Agnes down when they asked me for a loan, around 19:45 on Day 19.",
      "time": 27110,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "agnes"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "in": "K0249",
      "key": "K0220",
      "place": null,
      "source": "self",
      "text": "Agnes came asking me for money, around 19:45 on Day 19. Times are hard for them.",
      "time": 27110,
      "topics": [
       "money",
       "person:agnes"
      ]
     },
     {
      "about": [
       "nora",
       "selma"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0221",
      "place": null,
      "source": "told",
      "text": "Selma told me Nora paid them back 40 crowns around 10:00 on Day 19.",
      "time": 26514,
      "topics": [
       "money",
       "person:nora",
       "person:selma",
       "rumors"
      ]
     },
     {
      "about": [
       "nora",
