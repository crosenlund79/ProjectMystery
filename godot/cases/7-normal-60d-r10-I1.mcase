      ],
      "place": null,
      "source": "self",
      "text": "On Day 23, from about 09:00 I was at the mill; home around 16:15; at the Drover's Rest from about 18:00; home around 22:30 and to bed; on Day 24 back at the mill from about 07:15; after that it gets hazy \u2014 I'd had a fair bit to drink; home around 16:30 and to bed.",
      "time": 32220,
      "topics": [
       "whereabouts"
      ]
     },
