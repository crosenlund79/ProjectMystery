      "facts": [],
      "guarded": false,
      "in": "K0413",
      "key": "K0382",
      "place": null,
      "source": "saw",
      "text": "I saw Greta turn Agnes down for a loan around 19:45 on Day 19.",
      "time": 27110,
      "topics": [
       "money",
       "person:agnes",
       "person:greta"
      ]
     },
     {
      "about": [
