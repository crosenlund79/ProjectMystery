      ],
      "place": null,
      "source": "self",
      "text": "On Day 23, from about 09:00 I was at the mill; home around 16:15 and to bed; on Day 24 back at the mill from about 07:30; home around 16:30; at the Drover's Rest from about 19:00; home around 22:15 and to bed.",
      "time": 32220,
      "topics": [
       "whereabouts"
      ]
