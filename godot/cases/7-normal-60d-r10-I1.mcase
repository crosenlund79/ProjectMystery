      ],
      "era": "earlier",
      "facts": [],
      "guarded": true,
      "key": "K0222",
      "place": null,
      "source": "told",
      "text": "Agnes told me Nora couldn't pay the rent to Selma.",
      "time": 20580,
      "topics": [
