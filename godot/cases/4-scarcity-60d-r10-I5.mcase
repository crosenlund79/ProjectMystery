      "guarded": false,
      "key": "K0452",
      "place": null,
      "source": "self",
      "text": "On Day 58: from about 15:15 to 18:00 I was at the grocery; around 18:04 I passed through the square; from about 18:15 to 19:00 I was at home; around 19:07 I passed through the square; from about 19:15 to 20:00 I was at the Lantern; around 20:02 I passed through the square; around 20:08 I passed through Mill Road; from about 20:15 to 21:00 I was at the Brandt house; around 21:05 I passed through Mill Road; around 21:11 I passed through the square; from about 21:15 to 08:00 I was at home, asleep for most of it.",
      "time": 83002,
      "topics": [
       "whereabouts"
      ]
     },
