      ],
      "guarded": false,
      "key": "K0001",
      "place": null,
      "source": "self",
      "text": "On Day 58: from about 15:15 to 16:00 I was at the mill; around 16:07 I passed through Mill Road; around 16:13 I passed through the square; from about 16:15 to 17:15 I was at home; around 17:13 I passed through the square; from about 17:15 to 18:00 I was at the grocery; around 18:05 I passed through the square; from about 18:15 to 19:15 I was at home; around 19:11 I passed through the square; from about 19:15 to 22:15 I was at the Lantern; around 22:12 I passed through the square; from about 22:15 to 07:00 I was at home, asleep for most of it; around 07:05 I passed through the square; around 07:11 I passed through Mill Road; from about 07:15 to 08:00 I was at the mill; after that it gets hazy \u2014 I'd had a fair bit to drink.",
      "time": 83002,
      "topics": [
       "whereabouts"
      ]
     },
