      "key": "K0323",
      "place": null,
      "source": "self",
      "text": "On Day 19: from about 21:00 to 23:00 I was at the Drover's Rest; around 23:05 I passed through the square; around 23:11 I passed through Mill Road; from about 23:15 to 11:00 I was at home, asleep for most of it; around 11:06 I passed through Mill Road; around 11:12 I passed through the square; from about 11:15 to 11:45 I was at the Drover's Rest.",
      "time": 27179,
      "topics": [
       "whereabouts"
      ]
     },
