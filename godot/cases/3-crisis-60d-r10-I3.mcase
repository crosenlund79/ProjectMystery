      "topics": [
       "money"
      ]
     },
     {
      "about": [
       "emil",
       "ida",
       "jonas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0532",
      "members": [
       "K0503",
       "K0510"
      ],
      "place": null,
      "source": "saw",
      "text": "I saw Emil ask Ida and Jonas for money a while ago and get turned down.",
      "time": 19854,
      "topics": [
       "money",
       "person:emil"
      ]
     },
     {
      "about": [
       "emil",
       "ida",
       "jonas"
      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0533",
      "members": [
       "K0504",
       "K0527"
      ],
      "place": null,
      "source": "saw",
      "text": "I hear Jonas was asking around for money a while ago, and Emil and Ida said no.",
      "time": 19914,
      "topics": [
       "money",
       "person:jonas",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "daniel",
       "jonas"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0534",
      "members": [
       "K0505",
       "K0509"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Daniel and Jonas owe Clara money.",
      "time": null,
      "topics": [
       "money",
       "person:clara",
       "rumors"
      ]
     },
     {
      "about": [
       "clara",
       "ida",
