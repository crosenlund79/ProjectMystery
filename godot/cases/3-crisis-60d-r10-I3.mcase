       }
      ],
      "guarded": false,
      "in": "K0537",
      "key": "K0538",
      "place": null,
      "source": "self",
      "text": "On Day 19: from about 21:00 to 07:00 I was at home, asleep for most of it; around 07:04 I passed through the square; around 07:10 I passed through Mill Road; from about 07:15 to 11:45 I was at the mill.",
      "time": 27179,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "arvid",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0539",
      "place": null,
      "source": "told",
      "text": "Arvid told me there's bad blood between them and Ida \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:arvid",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "ida"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0540",
      "place": null,
      "source": "told",
      "text": "Henrik told me Arvid owes Ida 73 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:arvid",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
       "emil",
       "henrik"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0541",
      "place": null,
      "source": "told",
      "text": "Margaret told me Emil owes Henrik 83 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:emil",
       "person:henrik",
       "rumors"
      ]
     },
     {
      "about": [
       "daniel",
       "henrik"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0578",
      "key": "K0542",
      "place": null,
      "source": "told",
      "text": "Henrik told me Daniel owes them 64 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:daniel",
       "person:henrik",
       "rumors"
      ]
     },
     {
      "about": [
       "ida",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0579",
      "key": "K0543",
      "place": null,
      "source": "told",
      "text": "Margaret told me Tomas owes Ida 52 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:ida",
       "person:tomas",
       "rumors"
      ]
     },
     {
      "about": [
       "emil",
       "jonas"
      ],
      "facts": [],
      "guarded": true,
      "key": "K0544",
      "place": null,
      "source": "told",
      "text": "Margaret told me Jonas owes Emil 31 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:emil",
       "person:jonas",
       "rumors"
      ]
     },
