      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0545",
      "place": null,
      "source": "told",
      "text": "Henrik told me them laid Margaret off from the mill.",
      "time": 6240,
      "topics": [
       "money",
       "person:henrik",
       "person:margaret",
       "rumors"
      ]
     },
     {
      "about": [
       "arvid",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0579",
      "key": "K0546",
      "place": null,
      "source": "told",
      "text": "Ida told me Arvid is behind on paying them back (73 crowns).",
      "time": null,
      "topics": [
       "money",
       "person:arvid",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
