      "members": [
       "K0538"
      ],
      "place": null,
      "source": "self",
      "text": "On Day 19, from about 21:00 I was at home; on Day 20 at the mill from about 07:15.",
      "time": 27179,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "vera"
      ],
      "facts": [
       {
