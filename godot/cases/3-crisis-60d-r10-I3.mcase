      ],
      "facts": [],
      "guarded": false,
      "key": "K0555",
      "place": null,
      "source": "saw",
      "text": "I know Jonas has been taking food on credit from Clara (32 crowns owed).",
      "time": null,
      "topics": [
       "money",
       "person:clara",
       "person:jonas"
      ]
     },
     {
      "about": [
       "henrik",
       "tomas"
      ],
      "facts": [],
      "guarded": false,
      "in": "K0578",
      "key": "K0556",
      "place": null,
      "source": "told",
      "text": "Henrik told me Tomas is behind on paying them back (40 crowns).",
