      ],
      "facts": [],
      "guarded": false,
      "in": "K0478",
      "key": "K0445",
      "place": null,
      "source": "told",
      "text": "Henrik told me Emil owes them 83 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:emil",
       "person:henrik",
       "rumors"
      ]
     },
     {
