      ],
      "era": "earlier",
      "facts": [],
      "guarded": false,
      "key": "K0535",
      "members": [
       "K0516",
       "K0517",
       "K0518"
      ],
      "place": null,
      "source": "told",
      "text": "I hear Margaret was asking around for money a while ago, and Clara and Ida said no.",
      "time": 20689,
      "topics": [
