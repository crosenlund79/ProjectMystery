      ],
      "facts": [],
      "guarded": false,
      "key": "K0159",
      "place": null,
      "source": "self",
      "text": "I owe Henrik 64 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:henrik"
      ]
     },
     {
      "about": [
