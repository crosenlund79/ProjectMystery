      "key": "K0081",
      "place": null,
      "source": "self",
      "text": "On Day 19: from about 21:00 to 08:15 I was at home, asleep for most of it; around 08:10 I passed through Mill Road; around 08:16 I passed through the square; from about 08:15 to 11:45 I was at the grocery.",
      "time": 27179,
      "topics": [
       "whereabouts"
      ]
     },
