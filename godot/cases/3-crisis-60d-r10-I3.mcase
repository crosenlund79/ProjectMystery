      "in": "K0441",
      "key": "K0442",
      "place": null,
      "source": "self",
      "text": "On Day 19: from about 21:00 to 09:00 I was at home, asleep for most of it; around 09:06 I passed through the square; around 09:12 I passed through Mill Road; from about 09:15 to 11:45 I was at the mill.",
      "time": 27179,
      "topics": [
       "whereabouts"
      ]
     },
     {
      "about": [
       "arvid",
       "ida"
      ],
      "facts": [],
      "guarded": false,
      "key": "K0443",
      "place": null,
      "source": "told",
      "text": "Arvid told me there's bad blood between them and Ida \u2014 an unpaid bill from last winter.",
      "time": null,
      "topics": [
       "conflicts",
       "person:arvid",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
