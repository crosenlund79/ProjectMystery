      ],
      "facts": [],
      "guarded": false,
      "in": "K0477",
      "key": "K0444",
      "place": null,
      "source": "told",
      "text": "Ida told me Arvid owes them 73 crowns.",
      "time": null,
      "topics": [
       "money",
       "person:arvid",
       "person:ida",
       "rumors"
      ]
     },
     {
      "about": [
