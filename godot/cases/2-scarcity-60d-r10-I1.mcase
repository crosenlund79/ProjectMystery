      "guarded": false,
      "key": "K0223",
      "place": null,
      "source": "self",
      "text": "On Day 14: from about 21:00 to 22:15 I was at the Crooked Pike; around 22:13 I passed through the square; around 22:19 I passed through Mill Road; from about 22:30 to 08:00 I was at home, asleep for most of it; around 08:05 I passed through Mill Road; around 08:11 I passed through the square; from about 08:15 to 09:15 I was at the grocery; after that it gets hazy \u2014 I'd had a fair bit to drink; around 09:09 I passed through the square; from about 09:15 to 11:45 I was at the workshop.",
      "time": 19979,
      "topics": [
       "whereabouts"
      ]
     },
