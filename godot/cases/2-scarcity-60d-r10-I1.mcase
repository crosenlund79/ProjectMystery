      "guarded": false,
      "key": "K0293",
      "place": null,
      "source": "self",
      "text": "On Day 14: from about 21:00 to 23:15 I was at the Crooked Pike; around 23:16 I passed through the square; around 23:18 I passed through Mill Road; from about 23:15 to 08:00 I was at home, asleep for most of it; around 08:05 I passed through Mill Road; around 08:11 I passed through the square; from about 08:15 to 09:00 I was at the grocery; around 09:03 I passed through the square; around 09:05 I passed through Mill Road; from about 09:00 to 11:45 I was at home.",
      "time": 19979,
      "topics": [
       "whereabouts"
      ]
     },
