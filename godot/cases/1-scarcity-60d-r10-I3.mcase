      ],
      "place": null,
      "source": "saw",
      "text": "From what I know and hear, Anton, Daniel, Greta, Ida and Marta owe Agnes money \u2014 Greta and Ida are behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:agnes",
