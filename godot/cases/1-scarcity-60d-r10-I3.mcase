      "members": [
       "K0193",
       "K0196"
      ],
      "place": null,
      "source": "told",
      "text": "From what I hear, Anton and Greta owe Margaret money, and they're behind with it.",
      "time": null,
      "topics": [
       "money",
       "person:margaret",
       "rumors"
      ]
     },
