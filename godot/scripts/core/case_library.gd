## The cases the player can open: the bundled library (res://cases, generated by the Python
## laboratory with ``python -m mystery build-library``) plus case files the player imported
## (copied to user://cases). Only spoiler-free summaries are ever listed.
extends RefCounted

const CaseFormat = preload("res://scripts/core/case_format.gd")

const BUNDLED_DIR := "res://cases/"

var user_cases: String
var entries := []
var problems := []


func _init(user_root := "user://") -> void:
	var root := user_root if user_root.ends_with("/") else user_root + "/"
	user_cases = root + "cases/"
	DirAccess.make_dir_recursive_absolute(user_cases)
	refresh()


func refresh() -> void:
	entries.clear()
	problems.clear()
	var seen := {}
	var index = _read_json(BUNDLED_DIR + "index.json")
	if typeof(index) == TYPE_DICTIONARY and index.get("format") == "project-mystery-library":
		for c in index.get("cases", []):
			entries.append({"case_id": c["case_id"], "title": c["title"], "town": c["town"], "season": c["season"],
					"difficulty": c["difficulty"], "start_label": c["start_label"], "path": BUNDLED_DIR + c["file"],
					"sha256": c.get("sha256", ""), "source": "bundled"})
			seen[c["case_id"]] = true
	else:
		problems.append("The bundled case index is missing or unreadable.")
	var dir := DirAccess.open(user_cases)
	if dir != null:
		for name in dir.get_files():
			if not name.ends_with(CaseFormat.EXTENSION):
				continue
			var loaded := CaseFormat.load_file(user_cases + name)
			if not loaded["ok"]:
				problems.append("%s: %s" % [name, loaded["errors"][0]])
				continue
			var pkg: Dictionary = loaded["package"]
			if seen.has(pkg["case_id"]):
				continue
			var s: Dictionary = pkg["summary"]
			entries.append({"case_id": pkg["case_id"], "title": s["title"], "town": s["town"], "season": s["season"],
					"difficulty": s["difficulty"], "start_label": s["start_label"], "path": user_cases + name,
					"sha256": "", "source": "imported"})
			seen[pkg["case_id"]] = true


static func _read_json(path: String):
	if not FileAccess.file_exists(path):
		return null
	var json := JSON.new()
	if json.parse(FileAccess.get_file_as_string(path)) != OK:
		return null
	return json.data


func find(case_id: String) -> Dictionary:
	for e in entries:
		if e["case_id"] == case_id:
			return e
	return {}


func load_package(entry: Dictionary) -> Dictionary:
	## {"ok", "package", "errors"}. Bundled files must still match the index checksum.
	if entry.get("sha256", "") != "" and FileAccess.get_sha256(entry["path"]) != entry["sha256"]:
		return {"ok": false, "package": null, "errors": ["This case file has been changed or damaged."]}
	var loaded := CaseFormat.load_file(entry["path"])
	if loaded["ok"] and loaded["package"]["case_id"] != entry["case_id"]:
		return {"ok": false, "package": null, "errors": ["The case file does not match the library index."]}
	return loaded


func import_file(path: String) -> Dictionary:
	## Validate a .mcase from anywhere on disk and add it to the player's library.
	var loaded := CaseFormat.load_file(path)
	if not loaded["ok"]:
		return {"ok": false, "case_id": "", "errors": loaded["errors"]}
	var pkg: Dictionary = loaded["package"]
	var target := user_cases + String(pkg["case_id"]) + CaseFormat.EXTENSION
	var f := FileAccess.open(target, FileAccess.WRITE)
	if f == null:
		return {"ok": false, "case_id": "", "errors": ["Could not copy the case into your library."]}
	f.store_string(FileAccess.get_file_as_string(path))
	f.close()
	refresh()
	return {"ok": true, "case_id": pkg["case_id"], "errors": []}
